#!/usr/bin/env bash
# Git-native traceability gate (standing rule 4): every commit message
# carries the feature/milestone IDs it implements; infrastructure commits
# use [meta]. Runs from any session or terminal.
set -euo pipefail

msg_file="$1"
# Strip comment lines git adds to the template before judging the message.
msg=$(grep -v '^#' "$msg_file" || true)

# Merges and reverts are generated by git itself; they carry no IDs of
# their own and blocking them only breaks ordinary workflows.
case "$msg" in
  "Merge "*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
esac

if ! printf '%s' "$msg" | grep -qE '\[(meta|[A-Za-z]{1,4}[0-9][^]]*)\]'; then
  {
    echo "COMMIT BLOCKED — message lacks feature/milestone IDs (standing rule 4)."
    echo "Remedy: name the IDs this commit implements, e.g."
    echo "  feat(e8): zfs replication [E8, AR3]"
    echo "Pure infrastructure commits use [meta]."
  } >&2
  exit 1
fi
