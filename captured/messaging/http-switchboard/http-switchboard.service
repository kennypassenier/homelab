[Unit]
Description=HTTPSwitchboard - reshapes a message and delivers it where the config says
After=network-online.target kyu.service
Wants=network-online.target

[Service]
Type=simple
# The listen address is the LAN one so Uptime Kuma can probe it; 8083 is
# this container's slot in the fleet port map (kyu 8080, cadvisor 8081,
# kyu-runner 8082, http-switchboard 8083, node_exporter 9100).
#
# The config is handed over by systemd rather than read from disk. It stays
# root-owned 0600 because it names the Home Assistant webhook id, and that id
# IS the credential for the notification dispatcher — while DynamicUser gives
# this service an identity that cannot read a root-only file. LoadCredential
# bridges exactly that: systemd copies it into a private directory only this
# unit can see, and %d expands to that directory.
LoadCredential=config:/etc/http-switchboard/config.toml
ExecStart=/usr/local/bin/http-switchboard %d/config --listen 10.10.10.9:8083
EnvironmentFile=/etc/http-switchboard/token.env
Restart=on-failure
RestartSec=5
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
