# Secrets never enter git (standing rule 10). Nothing enforced this until
# 2026-08-30: the repo had no .gitignore at all, and stayed clean only
# because no plaintext .env had been written into it yet. `git add -A` is
# used routinely here, so the guard has to exist before the first one is.
.env
.env.*
!.env.example
!.env.sample

# Build output
/target
/target-debian

# Client-side runtime state
/.client-state
