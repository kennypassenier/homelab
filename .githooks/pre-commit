#!/usr/bin/env bash
# Git-native quality gate (standing rule 7, Phase-5 amendment 2026-08-12).
#
# The Claude Code PreToolUse hook in .claude/hooks/ only loads in a session
# opened in this directory; this one holds from ANY session, terminal or
# tool. That is the whole point: enforcement must not depend on where the
# commit is typed.
#
# Wire-up (once per clone): git config core.hooksPath .githooks
# Deliberate bypass stays possible with `git commit --no-verify`, which is
# a conscious act rather than a silent gap.
set -euo pipefail

root=$(git rev-parse --show-toplevel)
cd "$root"

if ! command -v cargo >/dev/null 2>&1; then
  echo "COMMIT BLOCKED — cargo not found, so the gates cannot run." >&2
  echo "Remedy: install the Rust toolchain, or commit with --no-verify if" >&2
  echo "you are deliberately committing from a machine that cannot build." >&2
  exit 1
fi

# fix-guards review (LOW): the register gate below is python3. Without it
# `python3 …` failed with "command not found" in the middle of the hook,
# which reads like a broken gate rather than a missing tool.
if ! command -v python3 >/dev/null 2>&1; then
  echo "COMMIT BLOCKED — python3 not found, so the register gate cannot run." >&2
  echo "Remedy: install python3, or commit with --no-verify if you are" >&2
  echo "deliberately committing from a machine without it." >&2
  exit 1
fi

# fix-25: refuse a webhook id before spending minutes on the full suite.
if [ -x "$root/.githooks/check-secrets.sh" ]; then
  "$root/.githooks/check-secrets.sh" || exit 1
else
  echo "warning: .githooks/check-secrets.sh is missing; the secret gate did not run." >&2
fi

# public-repo-attack-map: refuse an internal network address added to docs.
if [ -x "$root/.githooks/check-internal-ips.sh" ]; then
  "$root/.githooks/check-internal-ips.sh" || exit 1
else
  echo "warning: .githooks/check-internal-ips.sh is missing; the internal-address gate did not run." >&2
fi

# fix-guards-2/4/5/6/8: a register row this commit adds or changes may not
# claim more than was measured — "done" needs a dated live measurement, an
# open gap someone holding it, a new row's tests a fail-first run, a status
# no future date; a staged INVARIANTS.md must number 1..N; a string a person
# reads may not carry a register id. The Rust checks over the same documents
# run only with the suite (GATE_FULL/GATE_TESTS), so these run here.
if [ -x "$root/.githooks/check-register.py" ]; then
  python3 "$root/.githooks/check-register.py" || exit 1
else
  echo "warning: .githooks/check-register.py is missing; the register gate did not run." >&2
fi

# The scans GitHub's CI ran until 2026-09-29 (Kenny: every build and check
# runs locally), on what this commit changes: gitleaks over the staged diff,
# and cargo-deny's advisories when Cargo.lock moves. `make release` scans the
# whole history once more. The pinned binaries are fetched on first use.
if ! make -s secrets-staged; then
  echo "COMMIT BLOCKED — gitleaks found a secret in the staged changes (values redacted above)." >&2
  echo "Remedy: remove it, or allowlist a proven false positive per file in .gitleaks.toml." >&2
  exit 1
fi
if git diff --cached --name-only | grep -qx 'Cargo.lock'; then
  if ! make -s advisories; then
    echo "COMMIT BLOCKED — Cargo.lock pins a crate with a known advisory (cargo deny, above)." >&2
    echo "Remedy: bump the crate, or record a reasoned ignore in deny.toml." >&2
    exit 1
  fi
fi
# The "release: vX [meta]" commit of `make release` changes only the
# workspace version, on a tree `make release` gated moments before (Kenny,
# 2026-09-29: "drie keer dezelfde testrun is dom, dat moet naar één"). The
# shared helper passes only when every changed line is an x.y.z `version =`
# line in Cargo.toml or Cargo.lock; anything else, or no helper, runs the
# gates. The commit-msg ID check still runs.
if [ -x "$root/.githooks/gate-stamp" ] \
   && "$root/.githooks/gate-stamp" version-only \
        'Cargo.toml:^version = "[0-9]+\.[0-9]+\.[0-9]+"$' \
        'Cargo.lock:^version = "[0-9]+\.[0-9]+\.[0-9]+"$' 2>/dev/null; then
  echo "pre-commit: only the workspace version changed — gates skipped (make release ran them)"
  exit 0
fi

# Generated docs follow the code they describe (2026-10-02: TEST_PLAN.md went
# stale three times in one morning, each found only by a failing gate). When
# the commit touches code or stack files, regenerate them from this tree and
# stage the result, so the commit carries docs that match it. A generator
# that fails leaves the file alone; the staleness test still catches it.
if git diff --cached --name-only | grep -qE '\.rs$|^stacks/|^admin/web/|^docs/INVARIANTS\.md$'; then
  for gen in testplan update-policy "runbook docs/DR_RUNBOOK.md"; do
    cargo run -q -p homelab-client --bin homelab -- $gen </dev/null >/dev/null 2>&1 || true
  done
  for doc in docs/deployment/TEST_PLAN.md docs/deployment/UPDATE_POLICY.md docs/DR_RUNBOOK.md; do
    if [ -f "$doc" ] && ! git diff --quiet -- "$doc"; then
      git add -- "$doc"
      echo "pre-commit: regenerated and staged $doc"
    fi
  done
fi

# Single source of truth: the same script the session hook runs.
gates="$root/.claude/hooks/gates.sh"
if [ ! -x "$gates" ]; then
  echo "COMMIT BLOCKED — $gates missing or not executable." >&2
  echo "Remedy: restore it from the dev-procedure hooks/ directory." >&2
  exit 1
fi

if ! out=$("$gates" 2>&1); then
  echo "COMMIT BLOCKED — gates failed (fmt / clippy -D warnings / tests)." >&2
  echo "$out" | tail -30 >&2
  echo "Remedy: fix the failures above, then commit again." >&2
  exit 1
fi
