#!/bin/sh
# rule-20 (disk-audit, 2026-10-01): the four pull-through caches already
# expire a cached manifest 168h after it was last pulled — proxy.ttl in each
# of dockerhub.yml/ghcr.yml/gcr.yml/lscr.yml, REGISTRY_STORAGE_DELETE_ENABLED
# in docker-compose.yml. What ttl expiry does NOT do is free the blob data
# an expired manifest was the last reference to: registry's own garbage
# collector is a separate step, and nothing ran it (measured 2026-08-31:
# 1.1G across the four caches, growing with every new tag ever pulled,
# unboundedly).
#
# Run against the live container (supported since registry 2.3; distribution
# docs: https://distribution.github.io/distribution/about/garbage-collection/)
# with --delete-untagged=false — only blobs an expired, already-deleted
# manifest left orphaned are removed; nothing a container still names is
# ever touched. Scheduled at 03:10, ahead of the host's own nightly round
# (04:00) and OPNsense's backup (01:00), so it never competes with either.
#
# fix-registry-1 (Kenny, 2026-10-09): it used to stop at the first failing
# cache. Measured: from 2026-10-05 dockerhub failed every night on a partial
# repositories/grafana/promtail (a `_manifests` directory and no `_layers`,
# left by an interrupted pull), and ghcr, gcr and lscr were never collected.
# Now every cache runs, each reports its own result, a repository directory
# the collector cannot walk is removed first (logged), and the exit status is
# non-zero at the end if any cache failed, so the timer unit still shows red.
set -u
failed=""
for name in dockerhub ghcr gcr lscr; do
    echo "== cache-$name =="
    # A repository with `_manifests` but no `_layers` aborts the whole walk
    # ("filesystem: ... _layers: no such file"). Nothing references it, so the
    # directory goes; the cache refetches it on the next pull.
    docker exec "cache-$name" sh -c '
        find /var/lib/registry/docker/registry/v2/repositories -type d -name _manifests 2>/dev/null |
        while read -r m; do
            repo=$(dirname "$m")
            if [ ! -d "$repo/_layers" ]; then
                echo "partial repository (no _layers), removed: $repo"
                rm -rf "$repo"
            fi
        done' || echo "cache-$name: partial-repository scan failed"
    if ! docker exec "cache-$name" registry garbage-collect --delete-untagged=false /etc/distribution/config.yml; then
        echo "cache-$name: garbage-collect FAILED"
        failed="$failed $name"
    fi
done
if [ -n "$failed" ]; then
    echo "registry-gc: failed for:$failed"
    exit 1
fi
