{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "/static/kp/dist/kp-themes.min.js": ["./types/kp-bundle.d.ts"]
    }
  },
  "include": [
    "js/**/*.js",
    "test/**/*.js",
    "types/**/*.d.ts",
    "refused/**/*.js"
  ]
}
