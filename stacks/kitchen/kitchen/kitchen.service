# kitchen — the golden unit (AR17), as the homelab's answers shaped it.
#
# StartLimitIntervalSec/Burst belong in [Unit]: in [Service] systemd
# ignores them silently ("Unknown key") and a crash loop stops after five
# tries. Wants= not Requires= for the network, so a slow link after a
# power cut does not park the unit. Type=notify: the unit is active only
# once the service sent READY=1 after binding (W9). ReadWritePaths covers
# the binary's directory too, or self-update verifies, downloads and then
# fails at the swap.
#
# Homelab layout (CT 121): the state root is the bind-mounted
# /appdata/kitchen/kitchen-config (env file included), the binary lives in
# /opt/kitchen/bin and must be owned by the kitchen user (a root-owned binary
# stops the self-update at the swap — fix-12). `homelab install-native`
# installs it; the stack file carries update_cmd.

[Unit]
Description=kitchen — AuDHD-friendly recipes: a wheel that chooses, cook mode with parallel tracks, backward timing, bad days
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0
StartLimitBurst=0

[Service]
Type=notify
User=kitchen
Group=kitchen
EnvironmentFile=/appdata/kitchen/kitchen-config/kitchen.env
WorkingDirectory=/appdata/kitchen/kitchen-config
# feat-backup-1: /run/kitchen/backup.sock, where `kitchen backup-pause`
# reaches the running service; outside the state root, so never archived.
RuntimeDirectory=kitchen
RuntimeDirectoryMode=0700
ExecStartPre=/opt/kitchen/bin/kitchen --check
ExecStart=/opt/kitchen/bin/kitchen
Restart=always
RestartSec=5s
KillSignal=SIGTERM
# Above the service's shutdown_timeout_ms (default 10 s), so N1's bound
# is the one that decides, not systemd's.
TimeoutStopSec=60
# Mirrored so `--check` can warn when the shutdown timeout would outlive it (critic #20).
# Explicit, not the binary's compiled-in default (CF-6 d, 2026-09-06): the
# unit says where the state lives, so a binary built with another default
# still runs against this machine's measured directory.
Environment=KITCHEN_STATE_DIR=/appdata/kitchen/kitchen-config
Environment=KITCHEN_TIMEOUT_STOP_SECS=60
# Traefik on CT 104 (10.10.10.4) is the proxy in front of this service: the
# only peer whose X-Forwarded-For/Proto are believed. Without it every client
# shares one rate-limit key, cookies are not Secure and passkeys stay off
# (the kit's "proxy headers from untrusted peer" warning, 2026-09-30).
Environment=KITCHEN_TRUSTED_PROXIES=10.10.10.4
# trusted-sources (Kenny, 2026-10-22: "alle software moet de trusted-admin
# van 10.10.10.10 opnemen"): a request straight from Kenny's workstation is the
# admin without a login (chassis-rs 3.13.0 and later; an older build ignores
# it). Equal to host.toml `trusted_sources`; admin's config_tests hold them so.
Environment=KITCHEN_TRUSTED_ADMINS=10.10.10.10
# eten (Kenny, 2026-10-22: "geen meldingen, geen loginschermen", never open
# to the internet): on this host Kitchen shows only the parents' Dutch
# wheel, without an account. Who may open it is Cloudflare Access's job (its
# eten app lets only the house's public address through), so Kitchen's own
# allow-list stays open; its default (10.10.10.0/24) would refuse the
# house's visits, which arrive through the tunnel from the public address.
Environment=KITCHEN_PARENTS_HOST=eten.kp-soft.dev
Environment=KITCHEN_PARENTS_ALLOW=0.0.0.0/0,::/0
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=/appdata/kitchen/kitchen-config /appdata/kitchen/kitchen-config-pre-update /opt/kitchen/bin
# S2: the swap needs write access to the binary's OWN directory only; a
# code-execution bug can then replace this service's binary, not latch or
# its neighbours. The rest is systemd's free hardening for a network daemon.
UMask=0077
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallArchitectures=native
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
PrivateDevices=yes
ProtectProc=invisible

[Install]
WantedBy=multi-user.target
