[Unit]
Description=kyu — durable message hub
Documentation=https://github.com/kennypassenier/kyu
After=network-online.target
Wants=network-online.target
# Never give up. systemd's default is to stop trying after a few restarts in
# a short window, which turns a transient fault into a permanent outage —
# exactly what this service is here to avoid.
#
# It sat in [Service] until 2026-09-02, where systemd ignores it: the drill
# on CT 118 printed "Unknown key 'StartLimitIntervalSec' in section
# [Service], ignoring", and the LIVE hub on CT 109 was measured the same
# minute at systemd's defaults — StartLimitIntervalUSec=10s, StartLimitBurst=5.
# So the hub every notification travels through would have given up
# permanently after five restarts in ten seconds, which is exactly how
# newsflash lost two hours of production on 2026-09-01.
StartLimitIntervalSec=0

[Service]
# kyu 2.1.0 handles SIGTERM: in-flight requests finish, the write-ahead log
# is folded back, and it exits 0 — bounded by its own KYU_SHUTDOWN_TIMEOUT_MS
# (default 10s). This is systemd's outer bound and is COUPLED to that budget:
# raise KYU_SHUTDOWN_TIMEOUT_MS and this has to rise with it, or systemd's
# patience becomes what ends the shutdown and the clean stop is back to
# square one (the kyu project's warning, 2026-09-02).
# Read off the running unit on 2026-09-02 and written here so the repository
# and the machine agree.
TimeoutStopSec=30
Type=simple
User=kyu
Group=kyu
# Config and data both live on the host now, bind-mounted in, so
# destroying this container costs nothing (Kenny, P1 2026-08-31).
EnvironmentFile=/appdata/kyu/kyu-config/kyu.env
ExecStart=/usr/local/bin/kyu

# Kenny asked for it to come back from trouble: always, not only on failure,
# with a short pause so a crash loop cannot spin the CPU.
Restart=always
RestartSec=2s

# The hub needs nothing but its data directory and a socket.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/appdata/kyu/kyu-config

[Install]
WantedBy=multi-user.target
