{
  "uid": "homelab-kyu",
  "title": "kyu",
  "tags": ["homelab", "generated"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {"from": "now-6h", "to": "now"},
  "description": "Generated by the homelab orchestrator for stack 'kyu' (). Edits here are overwritten on the next deploy — change the generator, not the dashboard.",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU per container",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{"expr": "rate(container_cpu_usage_seconds_total{stack=\"kyu\"}[5m])", "refId": "A"}]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory per container",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{"expr": "container_memory_usage_bytes{stack=\"kyu\"}", "refId": "A"}]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Restarts per container",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"expr": "changes(container_start_time_seconds{stack=\"kyu\"}[1h])", "refId": "A"}]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Filesystem used",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{"expr": "100 - (node_filesystem_avail_bytes{stack=\"kyu\",mountpoint=\"/\"} / node_filesystem_size_bytes{stack=\"kyu\",mountpoint=\"/\"} * 100)", "refId": "A"}]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Errors in range",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 16},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "value", "graphMode": "none"},
      "targets": [{"expr": "sum(count_over_time({stack=\"kyu\"} |~ \"(?i)(error|exception|fatal|panic)\" != \"level=info\" [$__range]))", "queryType": "instant", "refId": "A"}]
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Errors by container",
      "description": "One container producing thousands while the rest produce single digits is the normal shape here, and the useful one: it says where to look first.",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 5, "w": 18, "x": 6, "y": 16},
      "options": {"displayMode": "gradient", "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [{"expr": "topk(10, sum by (container_name) (count_over_time({stack=\"kyu\"} |~ \"(?i)(error|exception|fatal|panic)\" != \"level=info\" [$__range])))", "queryType": "instant", "refId": "A"}]
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Error lines",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 21},
      "options": {"showTime": true, "showLabels": true, "sortOrder": "Descending", "wrapLogMessage": true, "dedupStrategy": "none"},
      "targets": [{"expr": "{stack=\"kyu\"} |~ \"(?i)(error|exception|fatal|panic)\" != \"level=info\"", "refId": "A"}]
    }
  ]
}
