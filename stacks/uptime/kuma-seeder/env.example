# The seeder logs in to Uptime Kuma as a normal user. The real .env travels
# over the TLS line into the host vault (D12) and never lands here.
KUMA_USER=
KUMA_PASSWORD=
# Almanac's bearer token for source `uptime-kuma`, issued on almanac's
# dashboard. Empty means the seeder does not create the almanac notification.
ALMANAC_KUMA_TOKEN=
# Home Assistant's webhook for Uptime Kuma (automation.uptime_kuma_webhook),
# the full URL including its id. Empty means the seeder does not create the
# Home Assistant notification.
HA_KUMA_WEBHOOK_URL=
