# kyu — the golden unit (AR17), as the homelab's answers shaped it.
#
# StartLimitIntervalSec/Burst belong in [Unit]: in [Service] systemd
# ignores them silently ("Unknown key") and a crash loop stops after five
# tries. Wants= not Requires= for the network, so a slow link after a
# power cut does not park the unit. Type=notify: the unit is active only
# once the service sent READY=1 after binding (W9). ReadWritePaths covers
# the binary's directory too, or self-update verifies, downloads and then
# fails at the swap.
#
# Install, in this order — the user first, because the install command
# sets the owner itself:
#
#   useradd --system --no-create-home --shell /usr/sbin/nologin kyu
#   install -D -m755 -o kyu -g kyu kyu /opt/kyu/bin/kyu
#   install -m644 kyu.service /etc/systemd/system/kyu.service
#   install -d -o kyu -g kyu /appdata/kyu/kyu-config
#   install -m640 -o root -g kyu kyu.env /appdata/kyu/kyu-config/kyu.env
#   stat -c '%U:%G %n' /opt/kyu/bin/kyu     # must read kyu:kyu
#   systemctl enable --now kyu
#
# The owner is part of the install command on purpose. This block used to
# say "install … (the service owns that directory: chown -R kyu:
# /opt/kyu)", with the ownership as an aside on the next line. On
# 2026-09-19 someone installed kyu's binary by hand, ran the first line and
# not the second, and left it root-owned. Nothing failed then: it failed
# weeks later, at the next update, with a message blaming directory
# permissions that were never wrong (fix-21). An owner that cannot be
# forgotten separately cannot be forgotten.

[Unit]
Description=kyu — A self-documenting durable message hub for a homelab
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0
StartLimitBurst=0

[Service]
Type=notify
User=kyu
Group=kyu
EnvironmentFile=/appdata/kyu/kyu-config/kyu.env
WorkingDirectory=/appdata/kyu/kyu-config
ExecStartPre=/opt/kyu/bin/kyu --check
ExecStart=/opt/kyu/bin/kyu
Restart=always
RestartSec=5s
KillSignal=SIGTERM
# Above the service's shutdown_timeout_ms (default 10 s), so N1's bound
# is the one that decides, not systemd's.
TimeoutStopSec=60
# Mirrored so `--check` can warn when the shutdown timeout would outlive it (critic #20).
# Explicit, not the binary's compiled-in default (CF-6 d, 2026-09-06): the
# unit says where the state lives, so a binary built with another default
# still runs against this machine's measured directory.
Environment=KYU_STATE_DIR=/appdata/kyu/kyu-config
Environment=KYU_TIMEOUT_STOP_SECS=60
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=/appdata/kyu/kyu-config /appdata/kyu/kyu-config-pre-update /opt/kyu/bin
# S2: the swap needs write access to the binary's OWN directory only; a
# code-execution bug can then replace this service's binary, not latch or
# its neighbours. The rest is systemd's free hardening for a network daemon.
UMask=0077
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallArchitectures=native
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
PrivateDevices=yes
ProtectProc=invisible

[Install]
WantedBy=multi-user.target
