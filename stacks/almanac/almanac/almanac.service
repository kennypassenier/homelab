# almanac 3.0.0 on CT 112 — the project's golden unit (deploy/almanac.service,
# latch variant) with this container's real layout, measured 2026-09-06:
# the state root is the config directory the homelab owns
# (/appdata/almanac/almanac-config: profiles/, data/, latch.env), the binary
# lives in /opt/almanac/bin (kit layout, S2), and latch runs without --env
# exactly as the 2.4.0 unit did. The 2.4.0 unit is kept next to this file
# as almanac.service.2.4.0 and the 2.4.0 binary as /opt/almanac/almanac.
[Unit]
Description=Almanac — event-to-calendar hub
Documentation=https://github.com/kennypassenier/almanac
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0
StartLimitBurst=0

[Service]
# `latch run` spawns the service and waits, so latch is the main PID and
# READY=1 comes from a child: NotifyAccess=all lets systemd accept it.
Type=notify
NotifyAccess=all
User=almanac
Group=almanac
EnvironmentFile=/appdata/almanac/almanac-config/latch.env
Environment=ALMANAC_STATE_DIR=/appdata/almanac/almanac-config
# The homelab supervises updates (its stack file carries update_cmd); the
# kit's own loop stays out of it. Overrides the 2.x ALMANAC_SELF_UPDATE alias.
Environment=ALMANAC_UPDATE_MODE=supervised
# Mirrored so `--check` can warn when the shutdown timeout would outlive it.
Environment=ALMANAC_TIMEOUT_STOP_SECS=60
WorkingDirectory=/appdata/almanac/almanac-config
ExecStartPre=/usr/local/bin/latch run -- /opt/almanac/bin/almanac --check
ExecStart=/usr/local/bin/latch run -- /opt/almanac/bin/almanac
Restart=always
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# S2: the swap needs write access to the binary's own directory only.
ReadWritePaths=/appdata/almanac/almanac-config /opt/almanac/bin /opt/almanac-pre-update
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
